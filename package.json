{
  "name": "duragrit-vitrified-monorepo",
  "private": true,
  "version": "2.0.0",
  "description": "DuraGrit Vitrified - Corporate ERP & Mobile Retail Monorepo",
  "type": "module",
  "workspaces": [
    "web",
    "app"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@duragrit/web",
    "dev:web": "npm run dev --workspace=@duragrit/web",
    "dev:app": "npm run dev --workspace=@duragrit/app",
    "dev:admin-app": "npm run dev:admin --workspace=@duragrit/app",
    "dev:vendor-app": "npm run dev:vendor --workspace=@duragrit/app",
    "build": "npm run build --workspace=@duragrit/web && npm run build --workspace=@duragrit/app && node scripts/prepare_vercel_dist.cjs",
    "build:web": "npm run build --workspace=@duragrit/web",
    "build:app": "npm run build --workspace=@duragrit/app",
    "sync:app": "npm run sync --workspace=@duragrit/app",
    "test:logic": "node tests/test_phase3_logic.js"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/cli": "^6.1.2",
    "@capacitor/core": "^6.1.2",
    "@supabase/supabase-js": "^2.45.4",
    "canvas-confetti": "^1.9.3",
    "crypto-js": "^4.2.0",
    "html5-qrcode": "^2.3.8",
    "jspdf": "^2.5.1",
    "jspdf-autotable": "^3.8.2",
    "lucide-react": "^0.453.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "vite": "^5.4.9"
  }
}
