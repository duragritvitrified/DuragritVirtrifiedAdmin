{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "web/dist",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/apk/duragrit-contractor-v2.apk",
      "destination": "/app/?app=vendor",
      "permanent": false
    },
    {
      "source": "/apk/duragrit-admin-command-v2.apk",
      "destination": "/app/?app=admin",
      "permanent": false
    },
    {
      "source": "/apk",
      "destination": "/app/?app=vendor",
      "permanent": false
    },
    {
      "source": "/apk/(.*)",
      "destination": "/app/?app=vendor",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/app/(.*)",
      "destination": "/app/index.html"
    },
    {
      "source": "/app",
      "destination": "/app/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
