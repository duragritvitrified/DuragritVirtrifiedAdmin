# ====================================================================
# DURAGRIT VITRIFIED - ENTERPRISE ERP PORTAL
# Environment Variables Template (.env.local)
# Copy this file to .env.local and fill in your Supabase credentials.
# NEVER commit .env.local to version control.
# ====================================================================

# --- Supabase Project Credentials ---
# Found at: https://supabase.com/dashboard/project/<your-project-id>/settings/api
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY_HERE

# --- App Configuration ---
VITE_APP_NAME=DuraGrit Vitrified ERP Portal
VITE_APP_VERSION=2.0.0
VITE_ADMIN_EMAIL=duragrit07@gmail.com

# --- Session ---
# Admin session duration in milliseconds (default: 8 hours)
VITE_SESSION_DURATION_MS=28800000

# --- QR Engine ---
VITE_QR_ENGINE_VERSION=V2.4
VITE_QR_SALT=DURAGRIT_VITRIFIED_IND_2026_PROD

# --- NPCI Gateway Mode ---
# Set to "live" when connecting to actual NPCI UPI rails.
# Leave as "mock" for development / staging environments.
VITE_NPCI_MODE=mock

# --- Geo-Fencing ---
# Morbi Central Hub coordinates (lat, lng)
VITE_HQ_LAT=22.8173
VITE_HQ_LNG=70.8317
# Max allowed km radius for valid contractor scans
VITE_GEO_FENCE_RADIUS_KM=250
